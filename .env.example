# Local startup does not require these settings. This file is a template only.
# On a hosting provider, set these in its private Environment settings.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
PUBLIC_ORIGIN=https://your-service.example.com
DATA_DIR=/var/data/road-ai
MAX_VIDEO_MB=32
# Four DIFFERENT, random passwords, at least 16 characters each:
OPERATOR_PASSWORD=
DISPATCHER_PASSWORD=
WORKER_PASSWORD=
ADMIN_PASSWORD=

# Optional AI chat (server only):
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ASSISTANT_DAILY_LIMIT=50

# Set 1 to disable local inference. Model setup is a separate command.
DETECTOR_DISABLED=0
